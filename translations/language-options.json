    },
    {
      "url": "https://github.com/wikimedia/mediawiki/tree/ea83228d5fe2b1f9559196a2716c8580cdb2407d",
      "note": "Tai Nüa tdd autonym from includes/Languages/Data/Names.php and starter actions from languages/i18n/tdd.json. Legacy mistaken tai choice migrates to tdd."
    },
    {
      "url": "https://github.com/KDE/krita/tree/428d44705de20770434ea2915021241dc073879c/po",
      "note": "Eight additional partial locales from actual catalogue vocabulary; native language labels reviewed, with MediaWiki Names.php for cy, fy, ia, mai, tok, uz and wa."
    },
    {
      "url": "https://github.com/Kyubyong/h2h_converter",
      "note": "Reference for ordinary Korean Hangul–Hanja mixed orthography; ko-Kore-KR keeps Korean grammar/native vocabulary in Hangul and uses Hanja for suitable Sino-Korean vocabulary."
    },
    {
      "url": "https://github.com/nomnaviet/rime-nom-viet",
      "note": "Hán-Nôm lexical reference used to review character choices for the vi-Hani catalogue; AN Paint strings remain direct locale translations."
    }
