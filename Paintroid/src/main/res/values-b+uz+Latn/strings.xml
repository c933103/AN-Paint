    <string name="ui_assembly_saved">"Yigʻma tasvir saqlandi"</string>
    <string name="ui_assembly_source_memory_floor">"Hisobga koʻra, bu yigʻma tasvir eng kichik chiqish oʻlchamida ham joriy ishchi xotira chegarasidan oshadi. Joriy cheklovlarda faqat yigʻma tasvir oʻlchamlarini kichraytirish yetarli emas. Qayta urinishdan oldin boshqa hujjatlarni yoping yoki kichikroq manba rasm tayyorlang. Yigʻma tasviringiz oʻzgarmadi."</string>
