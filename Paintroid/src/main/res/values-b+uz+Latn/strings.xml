    <string name="gallery_credit_could_not_save">"Rasm yaratuvchisi, manbasi va litsenziyasi haqidagi maʼlumotlarni saqlab yoki tiklab boʻlmadi. Oldin saqlangan maʼlumotlar saqlab qolindi. Qayta urinib koʻring."</string>
    <string name="gallery_credit_too_large">"Rasm yaratuvchisi, manbasi va litsenziyasi haqidagi bu maʼlumotlar qoʻshilsa, chizma tiklash uchun haddan tashqari katta boʻlib qoladi. Oldingi chizma va ilgari saqlangan yaratuvchi, manba hamda litsenziya haqidagi maʼlumotlar saqlab qolindi."</string>
    <string name="legacy_credits_unreadable">"Yaratuvchi, manba va litsenziya haqidagi saqlangan maʼlumotlarning ayrimlarini oʻqib boʻlmadi. Ularning saqlangan nusxalari saqlab qolindi."</string>
    <string name="save20_destination_error">"Tayyor rasm bilan manzil faylini almashtirib boʻlmadi."</string>
