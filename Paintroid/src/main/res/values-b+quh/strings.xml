    <string name="ui_autosave_is_paused_to_protect_that_draft_use">%1$s Chay llank\'aypa kikinchasqanta jallch\'anapaq pachanmanta jallch\'ay tatichisqa. Chayta jallch\'anapaq “Khipu → Kutichinapaq kikinchasqata jawaman apachiy…” apaykachay; kunan llank\'ayniykita jallch\'anapaq “Khipu → Jinata jallch\'ay…” (Khipuqpa layan: PNG / JPEG) apaykachay.</string>
    <string name="save20_destination_error">Mana tukusqa pallayta nisqan khipu kananpi churayta atikunchu.</string>
    <string name="ui_the_undo_cache_is_damaged">Ruwaranapaq jallch\'asqa khipu mana allinchu.</string>
    <string name="ui_unexpected_data_in_the_undo_cache">Ruwaranapaq jallch\'asqa khipupi willaykuna puchun.</string>
    <string name="ui_history_unavailable34" formatted="false">Pallayqa kutichisqa, ichaqa mana ruwaranapaq jallch\'asqa khipukunata ñawiriyta atikunchu. Llank\'aypa ñawpaq kikinchasqan kutichinapaq jallch\'asqa.</string>
    <string name="ui_recovery_copy_exported_extract_canvas_png_from_the">Kutichinapaq kikinchasqa jawaman apachisqa. ZIPmanta canvas.png nisqa khiputa urqhuy, chaymanta “Khipu → Pallayta kichay…” apaykachaspa chay pallayta kichay. Llank\'aypa kikinchasqanpa aqllasqankunapis ZIP ukhupi kan. Pallayman manaraq t\'inkisqa ajllasqa kan chayqa, chaypis ZIP ukhupi kan.</string>
    <string name="ui_cannot_create_the_undo_cache_free_some_device">Mana ruwaranapaq khipukunata wallpayta atikunchu. Kay khipu jallch\'aq makinapi khipukunata jallch\'anapaq aswan ch\'usaq cheqanta saqiy, chaymanta watiqmanta p\'itwiy.</string>
    <string name="ui_a_separate_recovery_copy_has_been_kept_use">%1$s Kutichinapaq kikinchasqa t\'aqasqata jallch\'asqa. ZIP khipunta jallch\'anapaq “Khipu → Kutichinapaq kikinchasqata jawaman apachiy…” apaykachay. Chay ZIPmanta canvas.png nisqa khiputa urqhuy, chaymanta “Khipu → Pallayta kichay…” apaykachaspa chay pallayta kichay. Munaspaqa “Allichay → Pallaypata chhikanninta uqjinaychiy…” apaykachay.</string>
    <string name="ui_export_did_not_save23">Khipu wallpasqa. Ñawpaqta kunan pallayta jallch\'anapaq “Jallch\'ay” icha “Jinata jallch\'ay…” apaykachay; chaymanta ruakapuy.</string>
    <string name="ui_share_explanation34" formatted="false">Aqllasqayki k\'itipi huk kikinchasqata jallch\'ay. Chaymanta chayta rak\'inakunapaq huk programata aqllay. “Jallch\'ay” nisqapa kunan khipu kananta kayqa mana uqjinayachinqachu.</string>
    <string name="ui_there_is_not_enough_memory_for_this_operation">Pallaypa kikin chhikanninpi kayta ruwanapaq mana aswan memoria kanchu. Pallaypa chhikannin mana pachanmanta uqjinaychisqachu.</string>
    <string name="ui_save_explanation23">Pallay khipuqpa layanta, khipuqpa chhikanninta (KB/MB) pisiyachinapaq aqllasqakunatapis aqllay. “Jallch\'ay” nisqaqa kay khipuqpa sutinta, k\'itinta, layanta, chay aqllasqakunatapis watiqmanta apaykachanqa.</string>
    <string name="save20_encoding_budget">Pallaypaq khiputa qillqanapaqpis memoriaqa (RAM), jawaman apachinapaq AN Paintpa aqllasqan memoriamanta aswan.</string>
    <string name="ui_assembly_saved">Juñusqa pallay PNGpi jallch\'asqa.</string>
    <string name="ui_could_not_save_the_assembly">Mana juñusqa PNG pallayta jallch\'ayta atikunchu: %1$s</string>
    <string name="ui_png_encoding_failed">Mana pallayta PNG khipuqpa layanman tikrayta atikunchu.</string>
    <string name="ui_could_not_store_the_assembly">Mana pallaykunata juñunapaq willaykunata jallch\'ayta atikunchu.</string>
    <string name="ui_the_saved_assembly_could_not_be_opened">Mana pallaykunata juñunapaq jallch\'asqa willaykunata ñawiriyta atikunchu: %1$s</string>
    <string name="ui_an_assembly_source_image_is_missing">Pallaykunata juñunapaq huk pallay khipu mana kanchu.</string>
    <string name="ui_not_enough_memory_for_this_operation_the_assembly">Kayta ruwanapaq mana aswan memoria kanchu. Pallaykunata juñunapaq khipukuna jallch\'asqa.</string>
    <string name="ui_export_explanation23">ICO, Base64 icha ASCII khiputa jawaman apachiy. Kunan pallayta, “Jallch\'ay” nisqapa kunan khipu kanantapis kayqa mana uqjinayachinqachu.</string>
    <string name="formats22_derived_exported">%1$s jawaman apachisqa. Tukuy pallayniykipi manaraq jallch\'asqa uqjinayachisqakuna kan. Pallay kananpi hukta churanapaq, ñawpaqta tukuy pallaypa kikinchasqanta jallch\'ay.</string>
    <string name="formats22_animation_title">Kuyuq pallay</string>
    <string name="formats22_open_still">Mana kuyuq pallayta kichay</string>
    <string name="formats22_animation_still">AN Paintqa ñawpaq kaq pallayllata jawamanta apachimunqa. “Jallch\'ay” nisqaqa mana kuyuq pallay khiputa wallpanqa.</string>
    <string name="ui_assembly_source_memory_floor">Yupachasqaman jina, aswan juch\'uy pallayta wallpanapaqpis, kay pallaykunata juñunapaq memoriaqa (RAM) AN Paintpa kunan aqllasqan memoriamanta aswan. Juñusqa pallaypa chhikanninta pisiyachiywanlla mana kay pallaykunata juñuyta atikunchu. Wak qhilqa-khipukunata wisq\'ay icha kay pallaykunamanta hukpa aswan juch\'uy chhikanniyuq kikinchasqanta kamariy. Chaymanta watiqmanta p\'itwiy. Juñunapaq pallaykunapis willaykunapis mana uqjinayachisqachu.</string>
    <string name="formats22_animation_message">Kay %1$s khipupi patan patanpi rikuchinapaq %2$s pallaykuna kan. AN Paintqa mana kuyuq pallaykunallata uqjinayachin. Kuyuytataq mana jallch\'anchu.</string>
    <string name="formats22_animation_poster">Kay PNG khipupi mana kuyuchispa rikuchina pallay kan. Kay pallayqa patan patanpi rikuchina pallaykunamanta t\'aqasqa. AN Paintqa chay pallayta jawamanta apachimunqa, mana patan patanpi rikuchina pallaykunatachu. “Jallch\'ay” nisqaqa mana kuyuq pallay khiputa wallpanqa.</string>
    <string name="formats22_animation_unknown">Kay %1$s khipupi patan patanpi rikuchinapaq jukmanta aswan pallaykuna kanman. Ancha sasa khipu kasqanrayku, AN Paintqa chay pallaykunata yupayta mana tukuyta atinchu. Mana kuyuq pallayllata kichanqa. Kuyuytataq mana jallch\'anqachu.</string>
    <string name="ui_the_trim_would_remove_the_entire_image">Kay khuchuyqa lliw pallayta chinkachinman.</string>
    <string name="save20_lossy_quality_description">“Quality” nisqata yapayqa pallaypa aswan ashkha juch\'uy kaqninkunata jallch\'an. Chaywanqa, ashkha kutipi, khipuqa aswan jatun (KB/MB) kan.</string>
    <string name="ui_higher_quality_usually_makes_a_larger_file_lossless">“Quality” nisqata yapaywanqa, ashkha kutipi, khipuqa aswan jatun (KB/MB) kan. “Lossless” nisqaqa llapa llimphikunata mana uqjinayachispa jallch\'an.</string>
    <string name="save20_invalid_name">Khipupa sutinta qillqay. Ama “/”, “\\” icha Unicode U+0000-U+001F, U+007F-U+009F nisqa k\'illpakunata churaychu.</string>
    <string name="gallery_credit_could_not_save">Mana “Image credits” nisqa willaykunata jallch\'ayta icha kutichiyta atikunchu. Ñawpaq jallch\'asqa willaykuna jallch\'asqa. Watiqmanta p\'itwiy.</string>
    <string name="legacy_credits_unreadable">Mana wakin jallch\'asqa “Image credits” nisqa willaykunata ñawiriyta atikunchu. Chaykunapa kikinchasqankuna jallch\'asqa.</string>
    <string name="gallery_credit_too_large">Kay “Image credits” nisqa willaykunawanqa, pallayta kutichinapaq jallch\'ana willaykuna ancha ashkha kanman. Kunan pallaypis chaypi kaq “Image credits” nisqa willaykunapis jallch\'asqa.</string>
