        <item name="android:colorControlActivated">@color/editor_primary</item>
        <item name="android:colorControlHighlight">@color/editor_control_highlight</item>
        <item name="android:colorButtonNormal">@color/editor_secondary_container</item>
        <item name="android:colorAccent">@color/editor_primary</item>
        <item name="android:statusBarColor">@color/editor_primary</item>
        <item name="android:navigationBarColor">@color/editor_inverse_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
