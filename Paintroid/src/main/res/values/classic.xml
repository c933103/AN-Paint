<?xml version="1.0" encoding="utf-8"?>
<!-- AN Paint controls with Material Design 3 colours, 2026; AGPL-3.0-or-later. -->
<resources>
    <style name="ClassicPaintTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorBackground">@color/editor_surface</item>
        <item name="android:colorForeground">@color/editor_on_surface</item>
        <item name="android:textColorPrimary">@color/editor_on_surface</item>
        <item name="android:textColorSecondary">@color/editor_on_surface_variant</item>
