    <string name="formats22_animation_message">"קובץ %1$s זה מכיל %2$s פריימים. AN Paint עורך תמונות סטטיות ואינו משמר הנפשה."</string>
    <string name="formats22_animation_poster">"לקובץ PNG זה יש תמונת ברירת מחדל נפרדת. תמונה זו תיובא במקום פריימי ההנפשה. השמירה יוצרת תמונה סטטית."</string>
    <string name="formats22_animation_still">"רק הפריים הראשון ייובא. השמירה יוצרת תמונה סטטית."</string>
    <string name="formats22_animation_title">"תמונה מונפשת"</string>
    <string name="formats22_animation_unknown">"קובץ %1$s זה מורכב מכדי לוודא אם הוא מכיל כמה פריימים. AN Paint יפתח רק תמונה סטטית ולא ישמר הנפשה כלשהי."</string>
    <string name="formats22_ascii_description">"כתיבת טקסט פשוט באמצעות תווים בהירים וכהים. יש להציגו בגופן ברוחב קבוע. זהו ייצוג חזותי; אי אפשר לפתוח אותו מחדש כתמונה המקורית."</string>
    <string name="formats22_open_still">"פתיחת תמונה סטטית"</string>
    <string name="formats22_pdf_raster_hint">"עמודי PDF מרונדרים ב־144 dpi. טקסט ועצמים וקטוריים הופכים לפיקסלים."</string>
    <string name="gallery_credit_could_not_save">"לא ניתן היה לשמור או לשחזר את פרטי הייחוס של התמונה. פרטי הייחוס השמורים הקיימים נשמרו. נא לנסות שוב."</string>
    <string name="gallery_credit_too_large">"פרטי ייחוס אלה יהפכו את הציור לגדול מכדי לשחזרו. הציור ופרטי הייחוס הקודמים נשמרו."</string>
    <string name="legacy_credits_unreadable">"לא ניתן היה לקרוא חלק מפרטי הייחוס השמורים. העותקים המאוחסנים שלהם נשמרו."</string>
    <string name="save20_destination_error">"לא ניתן היה להחליף את קובץ היעד בתמונה שהושלמה."</string>
    <string name="save20_encoding_budget">"התמונה ומאגרי הקידוד חורגים מתקציב הזיכרון לייצוא."</string>
    <string name="save20_gif_description">"תמונה סטטית, עד 256 צבעים. ערבוב צבעים מחליק מעברי צבע. קובצי GIF מונפשים נפתחים בפריים הראשון שלהם."</string>
    <string name="save20_invalid_name">"יש להזין שם קובץ ללא לוכסנים או תווי בקרה."</string>
    <string name="save20_lossy_quality_description">"איכות גבוהה יותר משמרת יותר פרטים ובדרך כלל יוצרת קובץ גדול יותר."</string>
    <string name="save20_unsupported_image_colour">"תמונה זו משתמשת בפרופיל צבע ש־AN Paint עדיין אינו יכול להמיר. לפני הייבוא, יש להמיר אותה ל־PNG במרחב הצבע sRGB בעורך התומך בניהול צבע."</string>
    <string name="ui_a_separate_recovery_copy_has_been_kept_use">"%1$s נשמר עותק נפרד לשחזור. לשמירת קובץ ה־ZIP שלו, יש לבחור קובץ &gt; ייצוא עותק לשחזור. יש לחלץ ממנו את canvas.png ולטעון את התמונה כדי להשתמש באפשרויות הרגילות לשינוי גודל, במידת הצורך."</string>
    <string name="ui_an_assembly_source_image_is_missing">"חסרה תמונת מקור של ההרכבה."</string>
    <string name="ui_assembly_saved">"ההרכבה נשמרה"</string>
    <string name="ui_assembly_source_memory_floor">"לפי ההערכה, הרכבה זו חורגת מתקציב זיכרון העבודה הנוכחי, אפילו בגודל הפלט הקטן ביותר. תחת המגבלות הנוכחיות, הקטנת ממדי ההרכבה בלבד אינה מספיקה. יש לסגור מסמכים אחרים או להכין תמונת מקור קטנה יותר לפני ניסיון נוסף. ההרכבה לא השתנתה."</string>
    <string name="ui_autosave_failed_use_save">"השמירה האוטומטית נכשלה · יש להשתמש בשמירה"</string>
    <string name="ui_autosave_image_encoding_failed">"קידוד התמונה לשמירה אוטומטית נכשל."</string>
    <string name="ui_autosave_is_paused_to_protect_that_draft_use">"%1$s השמירה האוטומטית מושהית כדי להגן על הטיוטה ההיא. כדי לשמור אותה, יש לבחור „קובץ ← ייצוא עותק לשחזור…”, וכדי לשמור את העבודה הנוכחית יש לבחור „קובץ ← שמירה בשם…” (תבנית קובץ: PNG / JPEG)."</string>
    <string name="ui_autosave_metadata_is_missing">"חסרים נתוני העל של השמירה האוטומטית."</string>
    <string name="ui_autosave_paused_use_save">"השמירה האוטומטית מושהית · יש להשתמש בשמירה"</string>
    <string name="ui_autosave_pixels_are_missing">"חסרים הפיקסלים של השמירה האוטומטית."</string>
    <string name="ui_autosave_pixels_could_not_be_read">"לא ניתן היה לקרוא את הפיקסלים של השמירה האוטומטית."</string>
    <string name="ui_autosave_selection_encoding_failed">"קידוד הבחירה לשמירה אוטומטית נכשל."</string>
