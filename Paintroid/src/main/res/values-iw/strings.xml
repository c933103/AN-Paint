    <string name="ui_export_explanation23">"ייצוא סמל, טקסט Base64 או אמנות ASCII. הייצוא משאיר את התמונה הנוכחית ואת יעד השמירה שלה ללא שינוי."</string>
    <string name="ui_export_recovery_copy_144b8a">"ייצוא עותק לשחזור"</string>
    <string name="ui_higher_quality_usually_makes_a_larger_file_lossless">"איכות גבוהה יותר יוצרת בדרך כלל קובץ גדול יותר. מצב ללא אובדן משמר כל ערך צבע."</string>
    <string name="ui_history_unavailable34" formatted="false">"בד הציור שוחזר, אך לא ניתן היה לקרוא את היסטוריית ביטול הפעולות שלו. הטיוטה המקורית נשמרה כעותק לשחזור."</string>
