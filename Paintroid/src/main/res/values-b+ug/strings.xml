    <string name="colour_converter_unavailable">سۈرەتنىڭ رەڭ ئۆزگەرتىش پىروگراممىسىنى قوزغاتقىلى بولمىدى. سۈرەت ئەكىرىلمىدى.</string>
    <string name="colour_invalid_metadata">بۇ سۈرەتتە ئىناۋەتسىز ياكى قوللاپ-قۇۋۋەتلەنمەيدىغان رەڭ مېتا سانلىق مەلۇماتلىرى بار.</string>
    <string name="colour_truncated_metadata">سۈرەت ھۆججىتى رەڭ مېتا سانلىق مەلۇماتلىرىنىڭ ئىچىدە ئۈزۈلۈپ قالغان.</string>
    <string name="colour_unsupported_icc_model">بۇ سۈرەت كود يەشكۈچ ئۆزگەرتەلمەيدىغان ICC رەڭ مودېلىنى ئىشلىتىدۇ. ئالدى بىلەن رەڭ باشقۇرۇشنى قوللايدىغان ئەپتە RGB نۇسخىسىنى چىقىرىڭ.</string>
    <string name="commons_svg_original_size_too_large">SVG نىڭ ئەسلى چوڭلۇقى Android بىتمەپ ئۆلچىمى چېكىدىن ئېشىپ كەتتى. چوڭلۇق ئۆزگەرتىلمىدى.</string>
    <string name="commons_svg_original_size_unavailable">SVG دا ئىشلەتكىلى بولىدىغان ئەسلى چوڭلۇق كۆرسىتىلمىگەن. ئۇنىڭ ئورنىغا رەسىم سىزىش تەگلىكىگە ئاساسلانغان چوڭلۇق قويۇلمىدى.</string>
    <string name="formats22_animation_message">بۇ %1$s ھۆججىتىدە %2$s كاندۇك بار. AN Paint تۇراقلىق سۈرەتلەرنى تەھرىرلەيدۇ، جانلاندۇرۇمنى ساقلاپ قالمايدۇ.</string>
    <string name="formats22_animation_poster">بۇ PNG ھۆججىتىدە جانلاندۇرۇم قويۇلمىغاندا كۆرسىتىلىدىغان ئايرىم سۈرەت بار. جانلاندۇرۇم كاندۇكلىرىنىڭ ئورنىغا شۇ سۈرەت ئەكىرىلىدۇ. ساقلىغاندا تۇراقلىق سۈرەت ھاسىل بولىدۇ.</string>
    <string name="formats22_animation_still">پەقەت بىرىنچى كاندۇك ئەكىرىلىدۇ. ساقلىغاندا تۇراقلىق سۈرەت ھاسىل بولىدۇ.</string>
    <string name="formats22_animation_title">جانلاندۇرۇملۇق سۈرەت</string>
    <string name="formats22_animation_unknown">بۇ %1$s ھۆججىتى بەك مۇرەككەپ بولغاچقا، بىر نەچچە كاندۇك بار-يوقلۇقىنى جەزملەشتۈرگىلى بولمايدۇ. AN Paint پەقەت تۇراقلىق سۈرەتنى ئاچىدۇ، ھېچقانداق جانلاندۇرۇمنى ساقلاپ قالمايدۇ.</string>
    <string name="formats22_ascii_description">ئوچۇق ۋە قېنىق ھەرپلەر بىلەن ئاددىي تېكىست يازىدۇ. ئۇنى تەڭ كەڭلىكتىكى خەت نۇسخىسىدا كۆرۈڭ. بۇ سۈرەتنىڭ ھەرپلەر ئارقىلىق ئىپادىلىنىشى بولۇپ، ئۇنى ئەسلى سۈرەت سۈپىتىدە قايتا ئاچقىلى بولمايدۇ.</string>
    <string name="formats22_import_limit">بۇ ھۆججەت 512 MiB ئەكىرىش چېكىدىن ئېشىپ كەتتى. كىچىكرەك ھۆججەت تاللاڭ.</string>
    <string name="formats22_open_still">تۇراقلىق سۈرەتنى ئېچىش</string>
    <string name="formats22_pdf_raster_hint">PDF بەتلىرى 144 dpi دا سۈرەتكە ئايلاندۇرۇلىدۇ. تېكىست ۋە ۋېكتور جىسىملار پىكسېلغا ئايلىنىدۇ.</string>
    <string name="gallery_credit_could_not_save">سۈرەتنىڭ ئاپتورى، مەنبەسى ۋە ئىجازەتنامىسىگە دائىر ئۇچۇرلارنى ساقلىغىلى ياكى ئەسلىگە كەلتۈرگىلى بولمىدى. بۇرۇن ساقلانغان ئۇچۇرلار ساقلاپ قېلىندى. قايتا سىناڭ.</string>
    <string name="gallery_credit_too_large">سۈرەتنىڭ ئاپتورى، مەنبەسى ۋە ئىجازەتنامىسىگە دائىر بۇ ئۇچۇرلار رەسىمنى ئەسلىگە كەلتۈرگىلى بولمايدىغان دەرىجىدە چوڭ قىلىۋېتىدۇ. ئالدىنقى رەسىمىڭىز ۋە ئالدىنقى سۈرەتنىڭ ئاپتورى، مەنبەسى ۋە ئىجازەتنامىسىگە دائىر ئۇچۇرلار ساقلاپ قېلىندى.</string>
