    <string name="formats22_animation_message">"Tento obrázok vo formáte %1$s má nasledujúci počet snímok: %2$s. AN Paint upravuje statické obrázky a nezachováva animáciu."</string>
    <string name="formats22_animation_poster">"Tento obrázok PNG má samostatný predvolený obrázok. Namiesto animovaných snímok sa importuje tento obrázok. Uložením sa vytvorí statický obrázok."</string>
    <string name="formats22_animation_still">"Importuje sa iba prvá snímka. Uložením sa vytvorí statický obrázok."</string>
    <string name="formats22_animation_title">"Animovaný obrázok"</string>
    <string name="formats22_animation_unknown">"Tento obrázok vo formáte %1$s je príliš zložitý na overenie, či obsahuje viacero snímok. AN Paint otvorí iba statický obrázok a nezachová žiadnu animáciu."</string>
    <string name="formats22_ascii_description">"Zapíše obyčajný text pomocou svetlých a tmavých znakov. Zobrazte ho písmom s pevnou šírkou znakov. Ide o vizuálne stvárnenie; nemožno ho znova otvoriť ako pôvodný obrázok."</string>
    <string name="formats22_open_still">"Otvoriť statický obrázok"</string>
    <string name="formats22_pdf_raster_hint">"Strany PDF sa vykresľujú s rozlíšením 144 dpi. Text a vektorové objekty sa zmenia na pixely."</string>
    <string name="gallery_credit_could_not_save">"Údaje o pôvode obrázka sa nepodarilo uložiť alebo obnoviť. Existujúce uložené údaje boli zachované. Skúste to znova."</string>
    <string name="gallery_credit_too_large">"Tieto údaje o pôvode obrázka by spôsobili, že kresba bude príliš veľká na obnovenie. Vaša predchádzajúca kresba a údaje o pôvode boli zachované."</string>
    <string name="legacy_credits_unreadable">"Niektoré uložené údaje o pôvode sa nepodarilo prečítať. Ich uložené kópie boli zachované."</string>
    <string name="save20_destination_error">"Cieľový súbor sa nepodarilo nahradiť výsledným súborom."</string>
    <string name="save20_encoding_budget">"Obrázok a vyrovnávacie pamäte na kódovanie prekračujú pamäťový limit pre export."</string>
    <string name="save20_gif_description">"Statický obrázok s najviac 256 farbami. Rozptyľovanie vyhladzuje farebné prechody. Animované obrázky GIF sa otvoria ako ich prvá snímka."</string>
    <string name="save20_invalid_name">"Zadajte názov súboru bez lomiek a riadiacich znakov."</string>
    <string name="save20_lossy_quality_description">"Vyššia kvalita zachová viac detailov a zvyčajne vytvorí väčší súbor."</string>
    <string name="save20_unsupported_image_colour">"Tento obrázok používa farebný profil, ktorý AN Paint zatiaľ nedokáže previesť. Pred importom ho preveďte na PNG v priestore sRGB v editore so správou farieb."</string>
    <string name="ui_a_separate_recovery_copy_has_been_kept_use">"%1$s Bola zachovaná samostatná kópia na obnovu. Pomocou Súbor &gt; Exportovať kópiu na obnovu… uložte jej archív ZIP. Extrahujte z neho canvas.png a načítajte tento obrázok, aby ste v prípade potreby mohli použiť bežné možnosti zmeny mierky."</string>
    <string name="ui_an_assembly_source_image_is_missing">"Chýba zdrojový obrázok zostavy."</string>
    <string name="ui_assembly_saved">"Zostava bola uložená"</string>
    <string name="ui_assembly_source_memory_floor">"Odhaduje sa, že táto zostava prekročí aktuálny limit pracovnej pamäte aj pri najmenšej veľkosti výstupu. Pri súčasných obmedzeniach samotné zmenšenie rozmerov zostavy nestačí. Pred ďalším pokusom zatvorte iné dokumenty alebo pripravte menší zdrojový obrázok. Vaša zostava zostáva nezmenená."</string>
