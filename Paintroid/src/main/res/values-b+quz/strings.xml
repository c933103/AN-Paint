    <string name="ui_autosave_is_paused_to_protect_that_draft_use">%1$s Chay llank\'aypa kikinchasqanta waqaychanapaq pachanmanta waqaychay tatichisqa. Chayta waqaychanapaq “Khipu → Kutichinapaq kikinchasqata hawaman apachiy…” apaykachay; kunan llank\'ayniykita waqaychanapaq “Khipu → Kay hinata waqaychay…” (Khipupa layan: PNG / JPEG) apaykachay.</string>
    <string name="save20_destination_error">Mana tukusqa siq\'ita nisqan khipu kananpi churayta atikunchu.</string>
    <string name="ui_the_undo_cache_is_damaged">Ruwaranapaq waqaychasqa khipu mana allinchu.</string>
    <string name="ui_unexpected_data_in_the_undo_cache">Ruwaranapaq waqaychasqa khipupi willaykuna puchun.</string>
    <string name="ui_history_unavailable34" formatted="false">Siq\'iqa kutichisqa, ichaqa mana ruwaranapaq waqaychasqa khipukunata ñawinchayta atikunchu. Llank\'aypa ñawpa kikinchasqan kutichinapaq waqaychasqa.</string>
    <string name="ui_recovery_copy_exported_extract_canvas_png_from_the">Kutichinapaq kikinchasqa hawaman apachisqa. ZIPmanta canvas.png nisqa khiputa hurquy, hinaspa “Khipu → Siq\'ita kichay…” apaykachaspa chay siq\'ita kichay. Llank\'aypa kikinchasqanpa allichanankunapis ZIP ukhupi kan. Siq\'iman manaraq t\'inkisqa akllasqa kan chayqa, chaypis ZIP ukhupi kan.</string>
    <string name="ui_cannot_create_the_undo_cache_free_some_device">Mana ruwaranapaq khipukunata kamayta atikunchu. Kay dispositivopi khipukunata waqaychanapaq aswan k\'itita kachariy, hinaspa yapamanta ruwariy.</string>
    <string name="ui_a_separate_recovery_copy_has_been_kept_use">%1$s Kutichinapaq kikinchasqa sapaq waqaychasqa. ZIP khipunta waqaychanapaq “Khipu → Kutichinapaq kikinchasqata hawaman apachiy…” apaykachay. Chay ZIPmanta canvas.png nisqa khiputa hurquy, hinaspa “Khipu → Siq\'ita kichay…” apaykachaspa chay siq\'ita kichay. Munaspaqa “Allichay → Siq\'ipa chhikanninta uqjinaychiy…” apaykachay.</string>
    <string name="ui_export_did_not_save23">Khipu kamasqa. Ñawpaqta kunan siq\'ita waqaychanapaq “Waqaychay” icha “Kay hinata waqaychay…” apaykachay; hinaspa qatiy.</string>
    <string name="ui_share_explanation34" formatted="false">Aqllasqayki k\'itipi huk kikinchasqata waqaychay. Hinaspa chayta qunakunapaq huk programata aqllay. “Waqaychay” nisqapa kunan khipu kananqa kikillan kanqa.</string>
    <string name="ui_there_is_not_enough_memory_for_this_operation">Siq\'ipa kikin chhikanninpi kayta ruwanapaq mana aswan memoria kanchu. Siq\'ipa chhikannin mana pachanmanta uqjinaychisqachu.</string>
    <string name="ui_resize_large_image">Hatun siq\'ipa chhikanninta uqjinaychiyta munankichu?</string>
    <string name="ui_save_explanation23">Siq\'i khipupa layanta, khipupa chhikanninta (KB/MB) pisiyachinapaq allichanakunatapis aqllay. “Waqaychay” nisqaqa kay khipupa sutinta, k\'itinta, layanta, chay allichanakunatapis yapamanta apaykachanqa.</string>
    <string name="ui_the_selected_location_is_not_writable">Mana aqllasqa k\'itipi qillqayta atikunchu.</string>
    <string name="save20_encoding_budget">Siq\'ipaq khiputa qillqanapaqpis memoriaqa (RAM), hawaman apachinapaq AN Paintpa aqllasqan memoriamanta aswan.</string>
    <string name="ui_assembly_saved">Huñusqa siq\'i PNGpi waqaychasqa.</string>
    <string name="ui_could_not_save_the_assembly">Mana huñusqa PNG siq\'ita waqaychayta atikunchu: %1$s</string>
    <string name="ui_png_encoding_failed">Mana siq\'ita PNG khipupa layanman tikrayta atikunchu.</string>
    <string name="ui_could_not_store_the_assembly">Mana siq\'ikunata huñunapaq willaykunata waqaychayta atikunchu.</string>
    <string name="ui_the_saved_assembly_could_not_be_opened">Mana siq\'ikunata huñunapaq waqaychasqa willaykunata ñawinchayta atikunchu: %1$s</string>
    <string name="ui_an_assembly_source_image_is_missing">Siq\'ikunata huñunapaq huk siq\'i khipu mana kanchu.</string>
    <string name="ui_not_enough_memory_for_this_operation_the_assembly">Kayta ruwanapaq mana aswan memoria kanchu. Siq\'ikunata huñunapaq khipukuna waqaychasqa.</string>
    <string name="ui_export_explanation23">ICO, Base64 icha ASCII khiputa hawaman apachiy. Kunan siq\'iqa kikillan kanqa. “Waqaychay” nisqapa kunan khipu kananqa kikillan kanqa.</string>
    <string name="formats22_derived_exported">%1$s hawaman apachisqa. Tukuy siq\'iykipi manaraq waqaychasqa allichaykuna kan. Siq\'i kananpi hukta churanapaq, ñawpaqta tukuy siq\'ipa kikinchasqanta waqaychay.</string>
    <string name="formats22_animation_title">Kuyuq siq\'i</string>
    <string name="formats22_open_still">Mana kuyuq siq\'ita kichay</string>
    <string name="formats22_animation_still">AN Paintqa ñawpaq kaq siq\'illata hawamanta apachimunqa. “Waqaychay” nisqaqa mana kuyuq siq\'i khiputa kamanqa.</string>
    <string name="ui_assembly_source_memory_floor">Tantiyasqaman hina, aswan huch\'uy siq\'ita kamanapaqpis, kay siq\'ikunata huñunapaq memoriaqa (RAM) AN Paintpa kunan aqllasqan memoriamanta aswan. Huñusqa siq\'ipa chhikanninta pisiyachiywanlla mana kay siq\'ikunata huñuyta atikunchu. Wak qhilqa-khipukunata wisq\'ay icha kay siq\'ikunamanta hukpa aswan huch\'uy chhikanniyuq kikinchasqanta kamariy. Hinaspa yapamanta ruwariy. Huñunapaq siq\'ikunapis willaykunapis mana uqjinaychisqachu.</string>
    <string name="formats22_animation_message">Kay %1$s khipupi qati qati qhawarichinapaq %2$s siq\'ikuna kan. AN Paintqa mana kuyuq siq\'ikunallata uqjinaychin. Kuyuytataq mana waqaychanchu.</string>
    <string name="formats22_animation_poster">Kay PNG khipupi mana kuyuchispa qhawarichina siq\'i kan. Kay siq\'iqa qati qati qhawarichina siq\'ikunamanta sapaq. AN Paintqa chay siq\'ita hawamanta apachimunqa, mana qati qati qhawarichina siq\'ikunatachu. “Waqaychay” nisqaqa mana kuyuq siq\'i khiputa kamanqa.</string>
    <string name="formats22_animation_unknown">Kay %1$s khipupi qati qati qhawarichinapaq hukmanta aswan siq\'ikuna kanman. Ancha sasa khipu kasqanrayku, AN Paintqa chay siq\'ikunata yupayta mana tukuyta atinchu. Mana kuyuq siq\'illata kichanqa. Kuyuytataq mana waqaychanqachu.</string>
    <string name="ui_the_trim_would_remove_the_entire_image">Kay kuchuyqa llapan siq\'ita chinkachinman.</string>
    <string name="save20_lossy_quality_description">“Quality” nisqata yapayqa siq\'ipa aswan askha huch\'uy kaqninkunata waqaychan. Chaywanqa, askha kutipi, khipuqa aswan hatun (KB/MB) kan.</string>
    <string name="ui_higher_quality_usually_makes_a_larger_file_lossless">“Quality” nisqata yapaywanqa, askha kutipi, khipuqa aswan hatun (KB/MB) kan. “Lossless” nisqaqa llapan llimp\'ikunata mana uqjinaychispa waqaychan.</string>
    <string name="save20_invalid_name">Khipupa sutinta qillqay. Ama “/”, “\\” icha Unicode U+0000-U+001F, U+007F-U+009F nisqa k\'illpakunata churaychu.</string>
    <string name="gallery_credit_could_not_save">Mana “Image credits” nisqa willaykunata waqaychayta icha kutichiyta atikunchu. Ñawpa waqaychasqa willaykuna waqaychasqa. Yapamanta ruwariy.</string>
    <string name="legacy_credits_unreadable">Mana wakin waqaychasqa “Image credits” nisqa willaykunata ñawinchayta atikunchu. Chaykunapa kikinchasqankuna waqaychasqa.</string>
    <string name="gallery_credit_too_large">Kay “Image credits” nisqa willaykunawanqa, siq\'ita kutichinapaq waqaychana willaykuna ancha askha kanman. Kunan siq\'ipis chaypi kaq “Image credits” nisqa willaykunapis waqaychasqa.</string>
