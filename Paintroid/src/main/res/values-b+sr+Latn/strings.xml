    <string name="save20_encoding_budget">"Slika i baferi za kodiranje premašuju ograničenje memorije za izvoz."</string>
    <string name="save20_gif_description">"Statična slika sa najviše 256 boja. Didering ublažava prelaze između boja. Animirane GIF slike otvaraju se kao prvi kadar animacije."</string>
    <string name="save20_invalid_name">"Unesite naziv datoteke bez kosih crta i kontrolnih znakova."</string>
