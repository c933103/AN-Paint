    <string name="save20_gif_description">"Statična slika z največ 256 barvami. Stresanje zgladi barvne prehode. Animirani GIF-i se odprejo kot prva sličica."</string>
    <string name="save20_invalid_name">"Vnesite ime datoteke brez poševnic ali krmilnih znakov."</string>
    <string name="save20_lossy_quality_description">"Višja kakovost ohrani več podrobnosti in običajno pomeni večjo datoteko."</string>
    <string name="save20_unsupported_image_colour">"Ta slika uporablja barvni profil, ki ga AN Paint še ne more pretvoriti. Pred uvozom jo v urejevalniku z upravljanjem barv pretvorite v PNG z barvnim prostorom sRGB."</string>
    <string name="ui_a_separate_recovery_copy_has_been_kept_use">"%1$s Ohranjen je ločen obnovitveni izvod. Njegov ZIP shranite z možnostjo Datoteka → Izvozi obnovitveni izvod…. Iz njega izvlecite canvas.png in naložite to sliko, da po potrebi uporabite običajne možnosti spreminjanja merila."</string>
    <string name="ui_an_assembly_source_image_is_missing">"Manjka izvorna slika sestava."</string>
    <string name="ui_assembly_saved">"Sestav je shranjen"</string>
    <string name="ui_assembly_source_memory_floor">"Ocenjena poraba delovnega pomnilnika za ta sestav presega trenutno omejitev tudi pri najmanjši izhodni velikosti. Samo zmanjšanje mer sestava pri trenutnih omejitvah ne zadostuje. Pred ponovnim poskusom zaprite druge dokumente ali pripravite manjšo izvorno sliko. Vaš sestav ostaja nespremenjen."</string>
