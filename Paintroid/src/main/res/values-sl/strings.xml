    <string name="formats22_animation_message">"Število sličic v tej datoteki %1$s je %2$s. AN Paint ureja statične slike in ne ohrani animacije."</string>
    <string name="formats22_animation_poster">"Ta PNG ima ločeno privzeto sliko. Uvožena bo ta slika namesto animiranih sličic. Pri shranjevanju nastane statična slika."</string>
    <string name="formats22_animation_still">"Uvožena bo samo prva sličica. Pri shranjevanju nastane statična slika."</string>
    <string name="formats22_animation_title">"Animirana slika"</string>
    <string name="formats22_animation_unknown">"Ta datoteka %1$s je preveč zapletena, da bi bilo mogoče potrditi, ali vsebuje več sličic. AN Paint bo odprl samo statično sliko in ne bo ohranil nobene animacije."</string>
    <string name="formats22_ascii_description">"Zapiše navadno besedilo s svetlimi in temnimi znaki. Oglejte si ga s pisavo z enako širino znakov. To je slikovni prikaz; ni ga mogoče znova odpreti kot izvirno sliko."</string>
