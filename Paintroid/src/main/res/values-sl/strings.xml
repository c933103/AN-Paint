    <string name="gallery_credit_could_not_save">"Podatkov o virih slik ni bilo mogoče shraniti ali obnoviti. Obstoječi shranjeni podatki so ohranjeni. Poskusite znova."</string>
    <string name="gallery_credit_too_large">"Zaradi teh podatkov o virih slik bi bila risba prevelika za obnovitev. Vaša prejšnja risba in podatki o virih so ohranjeni."</string>
    <string name="legacy_credits_unreadable">"Nekaterih shranjenih podatkov o virih slik ni bilo mogoče prebrati. Njihovi shranjeni izvodi so ohranjeni."</string>
    <string name="save20_destination_error">"Ciljne datoteke ni bilo mogoče nadomestiti z nastalo datoteko."</string>
