    <string name="colour_invalid_metadata">படத்தில் செல்லுபடியாகாத அல்லது ஆதரிக்கப்படாத நிற மேல்தரவு உள்ளது.</string>
    <string name="colour_truncated_metadata">படக் கோப்பு அதன் நிற மேல்தரவின் நடுவிலேயே முடிகிறது.</string>
    <string name="colour_unsupported_icc_model">படக் குறிவிலக்கியால் மாற்ற முடியாத ICC நிற மாதிரியை இந்தப் படம் பயன்படுத்துகிறது. முதலில் நிற மேலாண்மை வசதியுள்ள செயலியில் RGB நகலை ஏற்றுமதி செய்யவும்.</string>
    <string name="commons_svg_original_size_too_large">SVG இன் அசல் அளவு Android பிட்மேப் பரிமாணங்களை மீறுகிறது. அளவு மாற்றப்படவில்லை.</string>
    <string name="commons_svg_original_size_unavailable">SVG இல் பயன்படுத்தக்கூடிய அசல் அளவு குறிப்பிடப்படவில்லை. அதற்குப் பதிலாக வரைசீலை அடிப்படையிலான அளவு பயன்படுத்தப்படவில்லை.</string>
    <string name="formats22_animation_message">இந்த %1$s கோப்பில் உள்ள சட்டகங்களின் எண்ணிக்கை: %2$s. AN Paint நிலையான படங்களைத் திருத்துகிறது; அசைவூட்டத்தைத் தக்கவைக்காது.</string>
    <string name="formats22_animation_poster">இந்த PNG கோப்பில் தனியான இயல்புநிலைப் படம் உள்ளது. அசைவூட்டச் சட்டகங்களுக்குப் பதிலாக அந்தப் படம் இறக்குமதி செய்யப்படும். சேமிக்கும்போது நிலையான படம் உருவாகும்.</string>
    <string name="formats22_animation_still">முதல் சட்டகம் மட்டுமே இறக்குமதி செய்யப்படும். சேமிக்கும்போது நிலையான படம் உருவாகும்.</string>
    <string name="formats22_animation_title">அசைவூட்டப்பட்ட படம்</string>
    <string name="formats22_animation_unknown">இந்த %1$s கோப்பு மிகவும் சிக்கலானது என்பதால் அதில் பல சட்டகங்கள் உள்ளனவா என்பதை உறுதிப்படுத்த முடியவில்லை. AN Paint நிலையான படத்தை மட்டுமே திறக்கும்; எந்த அசைவூட்டத்தையும் தக்கவைக்காது.</string>
    <string name="formats22_ascii_description">வெளிர் மற்றும் அடர் குறியுருக்களைப் பயன்படுத்தி எளிய உரையை எழுதுகிறது. சம அகல எழுத்துருவில் அதைப் பார்க்கவும். இது படத்தின் காட்சிப் பிரதிநிதி மட்டுமே; இதை அசல் படமாக மீண்டும் திறக்க முடியாது.</string>
    <string name="formats22_import_limit">இந்தக் கோப்பு 512 MiB இறக்குமதி வரம்பை மீறுகிறது. சிறிய கோப்பைத் தேர்ந்தெடுக்கவும்.</string>
    <string name="formats22_open_still">நிலையான படத்தைத் திற</string>
    <string name="formats22_pdf_raster_hint">PDF பக்கங்கள் 144 dpi அளவில் வரையப்படுகின்றன. உரையும் திசையன் பொருட்களும் படத்துணுக்குகளாக மாறுகின்றன.</string>
    <string name="gallery_credit_could_not_save">படத்திற்கான நன்றிக் குறிப்புகளைச் சேமிக்கவோ மீட்டெடுக்கவோ முடியவில்லை. ஏற்கெனவே சேமித்த நன்றிக் குறிப்புகள் தக்கவைக்கப்பட்டுள்ளன. மீண்டும் முயலவும்.</string>
    <string name="gallery_credit_too_large">இந்த நன்றிக் குறிப்புகள் வரைபடத்தை மீட்டெடுக்க முடியாத அளவுக்குப் பெரிதாக்கும். முந்தைய வரைபடமும் நன்றிக் குறிப்புகளும் தக்கவைக்கப்பட்டுள்ளன.</string>
    <string name="language20_current">செயலியின் மொழி: %1$s</string>
    <string name="language20_translation_note">செயலியின் மொழி\n\nAN Paint இன் மொழி வளங்களில் மொழிபெயர்ப்புகள் பராமரிக்கப்படுகின்றன. புதிய அல்லது மொழிபெயர்க்கப்படாத உரை ஆங்கிலத்தில் தோன்றும்.</string>
    <string name="legacy_credits_unreadable">சேமித்த சில நன்றிக் குறிப்புகளைப் படிக்க முடியவில்லை. சேமிக்கப்பட்ட அவற்றின் நகல்கள் தக்கவைக்கப்பட்டுள்ளன.</string>
    <string name="save20_destination_error">முழுமையாக உருவாக்கப்பட்ட படத்தை அதன் இலக்கில் உள்ள கோப்புக்குப் பதிலாக வைக்க முடியவில்லை.</string>
    <string name="save20_encoding_budget">படமும் குறியாக்க இடையகங்களும் ஏற்றுமதிக்கான நினைவக வரம்பை மீறுகின்றன.</string>
    <string name="save20_gif_description">நிலையான படம், அதிகபட்சம் 256 நிறங்கள். டிதரிங் நிறச் சாய்வுகளைச் சீராக்குகிறது. அசைவூட்டப்பட்ட GIF கோப்புகள் அவற்றின் முதல் சட்டகமாகத் திறக்கப்படும்.</string>
    <string name="save20_invalid_name">சாய்வுக்கோடுகளோ கட்டுப்பாட்டு எழுத்துகளோ இல்லாத கோப்புப் பெயரை உள்ளிடவும்.</string>
    <string name="save20_lossy_quality_description">உயர் தரம் அதிக விவரங்களைத் தக்கவைக்கும்; பொதுவாகப் பெரிய கோப்பை உருவாக்கும்.</string>
    <string name="save20_unsupported_image_colour">இந்தப் படத்தில் உள்ள நிறச் சுயவிவரத்தை AN Paint இப்போது மாற்ற முடியாது. இறக்குமதி செய்வதற்கு முன், நிற மேலாண்மை வசதியுள்ள திருத்தியில் இதை sRGB PNG ஆக மாற்றவும்.</string>
