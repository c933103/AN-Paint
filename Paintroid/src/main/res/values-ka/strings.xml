    <string name="formats22_animation_unknown">ეს %1$s ზედმეტად რთულია იმის დასადასტურებლად, შეიცავს თუ არა რამდენიმე კადრს. AN Paint მხოლოდ უძრავ გამოსახულებას გახსნის და ანიმაციას არ შეინარჩუნებს.</string>
    <string name="formats22_ascii_description">ჩვეულებრივ ტექსტს წერს ნათელი და მუქი სიმბოლოებით. სანახავად გამოიყენეთ თანაბარსიგანიანი შრიფტი. ეს ვიზუალური წარმოდგენაა; მისი საწყის გამოსახულებად ხელახლა გახსნა შეუძლებელია.</string>
    <string name="formats22_pdf_raster_hint">PDF-ის გვერდები გარდაიქმნება რასტრულ გამოსახულებად 144 dpi გარჩევადობით. ტექსტი და ვექტორული ობიექტები პიქსელებად იქცევა.</string>
    <string name="gallery_credit_could_not_save">გამოსახულების ავტორობის მონაცემების შენახვა ან აღდგენა ვერ მოხერხდა. უკვე შენახული მონაცემები შენარჩუნებულია. სცადეთ ხელახლა.</string>
    <string name="gallery_credit_too_large">გამოსახულების ავტორობის ეს მონაცემები ნახატს აღსადგენად ზედმეტად დიდს გახდის. თქვენი წინა ნახატი და ავტორობის მონაცემები შენარჩუნებულია.</string>
    <string name="legacy_credits_unreadable">შენახული ავტორობის ზოგი მონაცემის წაკითხვა ვერ მოხერხდა. მათი შენახული ასლები შენარჩუნებულია.</string>
    <string name="save20_gif_description">უძრავი გამოსახულება, მაქსიმუმ 256 ფერით. ხმაურის შერევა ფერთა გადასვლებს არბილებს. ანიმაციური GIF-ები პირველი კადრის სახით იხსნება.</string>
    <string name="save20_unsupported_image_colour">ეს გამოსახულება იყენებს ფერის პროფილს, რომლის გარდაქმნაც AN Paint-ს ჯერ არ შეუძლია. შემოტანამდე ფერების მართვის მქონე რედაქტორში გარდაქმენით ის sRGB PNG-დ.</string>
    <string name="ui_a_separate_recovery_copy_has_been_kept_use">%1$s აღდგენის ცალკე ასლი შენარჩუნებულია. მისი ZIP-ის შესანახად გამოიყენეთ ფაილი &gt; აღდგენის ასლის ექსპორტი. იქიდან ამოიღეთ canvas.png და ჩატვირთეთ ეს გამოსახულება, რათა საჭიროების შემთხვევაში ზომის შეცვლის ჩვეულებრივი პარამეტრები გამოიყენოთ.</string>
    <string name="ui_assembly_source_memory_floor">შეფასებით, ეს კომპოზიცია სამუშაო მეხსიერების მიმდინარე ლიმიტს აჭარბებს გამოსატანი გამოსახულების ყველაზე მცირე ზომაზეც კი. მიმდინარე შეზღუდვებში მხოლოდ კომპოზიციის ზომების შემცირება საკმარისი არ არის. ხელახლა ცდამდე დახურეთ სხვა დოკუმენტები ან მოამზადეთ უფრო მცირე საწყისი გამოსახულება. თქვენი კომპოზიცია უცვლელია.</string>
    <string name="ui_autosave_is_paused_to_protect_that_draft_use">%1$s ამ მონახაზის დასაცავად ავტომატური შენახვა შეჩერებულია. მის შესანარჩუნებლად გამოიყენეთ „ფაილი → აღდგენის ასლის ექსპორტი…“, ხოლო მიმდინარე ნამუშევრის შესანახად — „ფაილი → შენახვა როგორც…“ (ფაილის ფორმატი: PNG / JPEG).</string>
    <string name="ui_d_d_pixels_2f_mp_exceeds_the_current">%1$d × %2$d პიქსელი (%3$.2f MP) აჭარბებს უსაფრთხო რედაქტირების მიმდინარე %4$.2f MP ზღვარს. AN Paint მთელ გამოსახულებას მეხსიერებაში ინახავს და გარდაქმნებისა და მონიშნული არეებისთვის ადგილს იტოვებს. ამ ზღვარს ხელმისაწვდომი მეხსიერება განსაზღვრავს. ოპერაცია შეჩერდა ზედმეტად დიდი რასტრული გამოსახულებისთვის მეხსიერების გამოყოფამდე. ზომა ავტომატურად არ შეცვლილა.</string>
    <string name="ui_export_did_not_save23">ექსპორტი შეიქმნა. გაგრძელებამდე მიმდინარე გამოსახულების შესანახად გამოიყენეთ შენახვა ან შენახვა როგორც.</string>
    <string name="ui_export_explanation23">გაიტანეთ ხატულა, Base64 ტექსტი ან ASCII გამოსახულება. ექსპორტი მიმდინარე გამოსახულებასა და მისი შენახვის დანიშნულებას უცვლელად ტოვებს.</string>
    <string name="ui_history_unavailable34" formatted="false">ტილო აღდგენილია, მაგრამ მისი გაუქმების ისტორიის წაკითხვა ვერ მოხერხდა. თავდაპირველი მონახაზი აღდგენის ასლის სახით შენარჩუნებულია.</string>
    <string name="ui_keeps_pixels_at_the_top_left_smaller_canvas">ინარჩუნებს პიქსელების მდებარეობას ზედა მარცხენა კუთხის მიმართ. ტილოს ზომების შემცირება მარჯვენა ან ქვედა კიდის მიღმა პიქსელებს შლის; დაბრუნება მათ აღადგენს.</string>
    <string name="ui_recovery_copy_exported_extract_canvas_png_from_the">აღდგენის ასლი ექსპორტირებულია. ZIP-დან ამოიღეთ canvas.png და გახსენით ფაილი &gt; გამოსახულების ჩატვირთვა ბრძანებით. ZIP ასევე შეიცავს მონახაზის პარამეტრებსა და ნებისმიერ მცურავ მონიშნულ არეს.</string>
    <string name="ui_sampled_resize_memory_explanation">შეფასება მოიცავს მიმდინარე ტილოსა და გაცვლის ბუფერს, შემცირებული გარჩევადობით დეკოდირებასა და რედაქტირების ბუფერებს. მეხსიერების ფაქტობრივი მოხმარება იცვლება. უფრო მცირე ასლი დეტალებს კარგავს. თავდაპირველი ფაილი უცვლელი რჩება.</string>
    <string name="ui_save_explanation23">აირჩიეთ გამოსახულების ფორმატი და მისი შეკუმშვის პარამეტრები. შენახვა ხელახლა გამოიყენებს ამ ფაილის სახელს, მდებარეობას, ფორმატსა და პარამეტრებს.</string>
