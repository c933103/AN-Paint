    <string name="formats22_animation_message">"Iyi %1$s irimo amakadiri %2$s. AN Paint ihindura amashusho adakina kandi ntibika imigendekere y’amashusho akina."</string>
    <string name="formats22_animation_poster">"Iyi PNG ifite ishusho isanzwe yihariye. Iyo shusho ni yo izinjizwa aho kwinjiza amakadiri akina. Kubika bitanga ishusho idakina."</string>
    <string name="formats22_animation_still">"Hazinjizwa ikadiri ya mbere gusa. Kubika bitanga ishusho idakina."</string>
    <string name="formats22_animation_title">"Ishusho ikina"</string>
    <string name="formats22_animation_unknown">"Iyi %1$s irakomeye cyane ku buryo bidashoboka kwemeza niba irimo amakadiri menshi. AN Paint izafungura ishusho idakina gusa kandi ntizabika imigendekere iyo ari yo yose."</string>
    <string name="formats22_ascii_description">"Yandika umwandiko usanzwe ikoresheje inyuguti zifite urumuri n’izijimye. Wurebere mu myandikire ifite inyuguti z’ubugari bungana. Ni uburyo bwo kugaragaza ishusho gusa; ntushobora kongera kuwufungura nk’ishusho y’umwimerere."</string>
    <string name="formats22_open_still">"Fungura ishusho idakina"</string>
    <string name="formats22_pdf_raster_hint">"Amapaji ya PDF ahindurwa amashusho kuri 144 dpi. Umwandiko n’ibintu bya vector bihinduka pigiseli."</string>
    <string name="gallery_credit_could_not_save">"Amakuru y’uwakoze ishusho, inkomoko yayo n’uruhushya rwayo ntiyashoboye kubikwa cyangwa kugarurwa. Amakuru yari yarabitswe yagumishijwe. Ongera ugerageze."</string>
    <string name="gallery_credit_too_large">"Aya makuru y’uwakoze ishusho, inkomoko yayo n’uruhushya rwayo yatuma igishushanyo kiba kinini cyane ku buryo kitagarurwa. Igishushanyo cyawe cya mbere n’amakuru yacyo byagumishijwe."</string>
    <string name="legacy_credits_unreadable">"Amwe mu makuru yabitswe y’abakoze amashusho, inkomoko n’impushya ntiyashoboye gusomwa. Kopi zayo zabitswe zagumishijwe."</string>
    <string name="save20_destination_error">"Ishusho yarangiye ntiyashoboye gusimbura dosiye aho yagombaga kubikwa."</string>
    <string name="save20_encoding_budget">"Ishusho n’imyanya y’ububiko bwo kuyishyira muri kode birenze ingano y’ububiko bw’agateganyo yemerewe gusohora."</string>
    <string name="save20_file_format">"Imiterere ya dosiye"</string>
    <string name="save20_file_name">"Izina rya dosiye"</string>
    <string name="save20_gif_description">"Ishusho idakina, ifite amabara atarenze 256. Kuvanga utudomo tw’amabara bituma ihinduka ry’amabara ryoroha. GIF zikina zifungurwa ku ikadiri yazo ya mbere."</string>
    <string name="save20_invalid_name">"Andika izina rya dosiye ridafite imirongo iberamye cyangwa inyuguti zigenzura."</string>
    <string name="save20_lossy_quality_description">"Ubwiza buri hejuru bugumishaho utuntu duto tugaragara mu ishusho twinshi kurushaho kandi akenshi butuma dosiye iba nini kurushaho."</string>
    <string name="save20_title">"Bika nka…"</string>
    <string name="save20_unsupported_image_colour">"Iyi shusho ikoresha umwirondoro w’amabara AN Paint itarashobora guhindura. Banza uyihindure PNG ya sRGB muri porogaramu ihindura amashusho igenzura amabara mbere yo kuyinjiza."</string>
    <string name="ui_a_separate_recovery_copy_has_been_kept_use">"%1$s Kopi yihariye yo kugarura yagumishijwe. Koresha Dosiye &gt; Sohora kopi yo kugarura kugira ngo ubike ZIP yayo. Kuramo canvas.png maze winjize iyo shusho kugira ngo ukoreshe uburyo busanzwe bwo guhindura ingano niba bikenewe."</string>
    <string name="ui_an_assembly_source_image_is_missing">"Imwe mu mashusho y’inkomoko y’uruvange irabura."</string>
    <string name="ui_assembly_saved">"Uruvange rwabitswe"</string>
    <string name="ui_assembly_source_memory_floor">"Biteganyijwe ko uru ruvange rurenza ingano y’ububiko bw’agateganyo bwo gukora iriho ubu, no ku ngano ntoya ishoboka y’ishusho izasohoka. Kugabanya ibipimo by’uruvange gusa ntibihagije ku mbibi ziriho ubu. Funga izindi nyandiko cyangwa utegure ishusho y’inkomoko ntoya mbere yo kongera kugerageza. Uruvange rwawe ntirwahinduwe."</string>
