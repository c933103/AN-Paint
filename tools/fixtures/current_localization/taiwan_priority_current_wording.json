{
  "schema_version": 1,
  "note": "18 independently reviewed complete Taiwan Traditional Chinese corrections. Static expectations and consumer tests do not certify whole-language fluency or installed rendering. Two dormant context holds and the prior sampled-memory receipt remain separate.",
  "values": {
    "formats22_ascii_description": {
      "default": "Writes plain text using light and dark characters. View it in a monospaced font. This is a visual rendition; it cannot be reopened as the original image.",
      "zh-TW": "使用明暗不同的字元寫成純文字。請以等寬字型檢視。這只是視覺呈現，不能重新開啟為原始圖片。"
    },
    "save20_gif_description": {
      "default": "Still image, up to 256 colours. Dithering smooths colour gradients. Animated GIFs open as their first frame.",
      "zh-TW": "靜態圖片，最多 256 色。抖色可讓色彩漸層看起來更平滑。動畫 GIF 會開啟第一個畫格。"
    },
    "ui_a_separate_recovery_copy_has_been_kept_use": {
      "default": "%1$s A separate recovery copy has been kept. Use File > Export recovery copy to save its ZIP. Extract canvas.png from it and load that image to use the normal resize options if needed.",
      "zh-TW": "%1$s 已保留另一份復原副本。請使用「檔案」>「匯出復原副本」將其儲存為 ZIP。如需使用一般的大小調整選項，請從 ZIP 中解壓縮 canvas.png，再載入這張圖片。"
    },
    "ui_discard": {
      "default": "Discard",
      "zh-TW": "捨棄"
    },
    "ui_recovery_copy_exported_extract_canvas_png_from_the": {
      "default": "Recovery copy exported. Extract canvas.png from the ZIP and open it with File > Load image. The ZIP also contains draft settings and any floating selection.",
      "zh-TW": "已匯出復原副本。請從 ZIP 中解壓縮 canvas.png，並使用「檔案」>「開啟圖片」開啟。ZIP 也包含草稿設定及任何浮動選取範圍。"
    },
    "ui_save_a5d0d9": {
      "default": "Save…",
      "zh-TW": "儲存…"
    },
    "ui_save_your_changes": {
      "default": "Save your changes?",
      "zh-TW": "要儲存變更嗎？"
    },
    "language20_translation_note": {
      "default": "App language\\n\\nTranslations are maintained in AN Paint’s language resources. New or untranslated text appears in English.",
      "zh-TW": "應用程式語言\\n\\n翻譯內容會在 AN Paint 的語言資源中維護。新增或尚未翻譯的文字會以英文顯示。"
    },
    "ui_bg": {
      "default": "BG",
      "zh-TW": "背景"
    },
    "ui_choose_a_smaller_size": {
      "default": "Choose a smaller size.",
      "zh-TW": "請選擇較小的尺寸。"
    },
    "ui_crop_preview_drag_an_edge_or_corner_drag": {
      "default": "Crop preview. Drag an edge or corner; drag inside to move the crop.",
      "zh-TW": "裁切預覽。拖曳邊緣或角落調整大小；拖曳內部以移動裁切範圍。"
    },
    "ui_draw_again": {
      "default": "Draw again",
      "zh-TW": "繼續繪圖"
    },
    "ui_drawing_canvas_pinch_and_move_two_fingers_to": {
      "default": "Drawing canvas. Pinch and move two fingers to zoom and pan. Navigate mode also pans with one finger.",
      "zh-TW": "繪圖畫布。用兩指捏合或張開可縮放，移動兩指可平移。「移動與縮放」模式也可用單指平移。"
    },
    "ui_enter_all_four_trim_amounts": {
      "default": "Enter all four trim amounts.",
      "zh-TW": "請輸入全部四個邊緣的裁減量。"
    },
    "ui_fg": {
      "default": "FG",
      "zh-TW": "前景"
    },
    "ui_hex_rrggbb": {
      "default": "Hex #RRGGBB",
      "zh-TW": "十六進位 #RRGGBB"
    },
    "ui_no_resize_fits_decoder_memory": {
      "default": "Even the smallest output cannot fit this image’s decoder working buffers in the current memory budget. Cancel and use a smaller source image.",
      "zh-TW": "即使使用最小的輸出尺寸，此圖片的解碼器工作緩衝區仍會超出目前的記憶體上限。請取消並使用較小的來源圖片。"
    },
    "ui_not_enough_memory_to_finish_opening_this_image": {
      "default": "Not enough memory to finish opening this image",
