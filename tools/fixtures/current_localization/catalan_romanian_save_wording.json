  "note": "Exactly 10 independently reviewed missing P0 Save/export/share values per Catalan/Romanian locale. All 20 accepted unchanged. Bounded AI linguistic/source-static scope, not native-human/runtime/layout/whole-locale certification. All 254 inherited values and named holds remain unchanged.",
  "values": {
    "ui_could_not_save_image": {
      "default": "Could not save image",
      "ca": "\"No s’ha pogut desar la imatge\"",
      "ro": "\"Imaginea nu a putut fi salvată\""
    },
    "ui_export_did_not_save23": {
      "default": "The export was created. Use Save or Save as to save the current image before continuing.",
      "ca": "\"S’ha creat el fitxer exportat. Fes servir «Desa» o «Anomena i desa…» per desar la imatge actual abans de continuar.\"",
      "ro": "\"Fișierul exportat a fost creat. Folosește «Salvează» sau «Salvează ca…» pentru a salva imaginea curentă înainte de a continua.\""
    },
    "ui_export_explanation23": {
      "default": "Export an icon, Base64 text or ASCII art. Exporting keeps the current image and its Save destination unchanged.",
      "ca": "\"Exporta una icona, text Base64 o art ASCII. Exportar no modifica la imatge actual ni la destinació de l’opció «Desa».\"",
      "ro": "\"Exportă o pictogramă, text Base64 sau artă ASCII. Exportul nu modifică nici imaginea curentă, nici destinația folosită de «Salvează».\""
    },
    "ui_save_and_share": {
      "default": "Save and share…",
      "ca": "\"Desa i comparteix…\"",
      "ro": "\"Salvează și partajează…\""
    },
    "ui_save_and_share_41edb4": {
      "default": "Save and share",
      "ca": "\"Desa i comparteix\"",
      "ro": "\"Salvează și partajează\""
    },
    "ui_save_explanation23": {
      "default": "Choose an image format and its compression settings. Save will reuse this file name, location, format and settings.",
      "ca": "\"Tria un format d’imatge i els paràmetres de compressió. «Desa» reutilitzarà aquest nom de fitxer, aquesta ubicació, aquest format i aquests paràmetres.\"",
      "ro": "\"Alege un format de imagine și setările de compresie. «Salvează» va reutiliza acest nume de fișier, această locație, acest format și aceste setări.\""
    },
    "ui_saved": {
      "default": "Saved %1$s",
      "ca": "\"S’ha desat %1$s\"",
      "ro": "\"S-a salvat %1$s\""
    },
    "ui_share_explanation34": {
      "default": "Save a copy to your chosen location, then choose an app to share it. Your current Save destination stays unchanged.",
      "ca": "\"Desa una còpia a la ubicació que triïs i després tria una aplicació per compartir-la. La destinació actual de «Desa» no canvia.\"",
      "ro": "\"Salvează o copie în locația aleasă, apoi alege o aplicație pentru a o partaja. Destinația curentă folosită de «Salvează» rămâne neschimbată.\""
    },
    "ui_the_image_was_saved_but_android_could_not": {
      "default": "The image was saved, but Android could not open sharing: %1$s",
      "ca": "\"La imatge s’ha desat, però Android no ha pogut obrir el diàleg per compartir-la: %1$s\"",
      "ro": "\"Imaginea a fost salvată, dar Android nu a putut deschide dialogul de partajare: %1$s\""
    },
    "ui_your_current_image_has_unsaved_changes": {
      "default": "Your current image has unsaved changes.",
      "ca": "\"La imatge actual té canvis sense desar.\"",
      "ro": "\"Imaginea curentă are modificări nesalvate.\""
    }
  },
