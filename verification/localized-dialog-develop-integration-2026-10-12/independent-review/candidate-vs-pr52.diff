diff --git a/tools/commons_metadata_composition_scope.py b/tools/commons_metadata_composition_scope.py
new file mode 100644
index 0000000000..e951b9e4d2
--- /dev/null
+++ b/tools/commons_metadata_composition_scope.py
@@ -0,0 +1,46 @@
+"""Strict projections of the composed M02/M03 delta onto each original producer.
+
+Neither original fixture, pin nor historical whole-file endpoint is changed.
+Callbacks shared by both corrections stay in place until the remaining original
+producer's reversal is applied. Unknown, absent and repeated edits fail closed.
+"""
+from commons_metadata_m02_scope import before_m02_producer
+from commons_metadata_m03_scope import production_fixture
+
+HTTP_HELPER = '''    /** Do not classify provider/framework exceptions by their text or format their detail twice. */
+    private fun commonsMetadataReason(error: Exception): String? =
+        if(error is CommonsAttribution.HttpException) ui(R.string.commons_metadata_http_error,error.status.toString())
+        else error.message
+
+'''
+LIMIT_BRANCH = '        else if(error is CommonsAttribution.ResponseLimitException) ui(R.string.commons_metadata_response_too_large)\n'
+COMBINED_HELPER = HTTP_HELPER.replace('        else error.message\n', LIMIT_BRANCH + '        else error.message\n')
+
+
+def replace_once(path, text, old, new):
+    if not old or text.count(old) != 1:
+        raise AssertionError(f'{path}: expected one exact composed metadata edit')
+    return text.replace(old, new, 1)
+
+
+def without_m03_production(path, text):
+    """Project onto accepted M02 source, keeping its two UI callbacks verbatim."""
+    if path.endswith('/CommonsAttribution.kt'):
+        row = next(row for row in production_fixture()['entries'] if row['path'] == path)
+        for edit in reversed(row['edits']):
+            text = replace_once(path, text, edit['after'], edit['before'])
+    elif path.endswith('/MediaGalleryActivity.kt'):
+        text = replace_once(path, text, COMBINED_HELPER, HTTP_HELPER)
+    return text
+
+
+def without_m02_production(path, text):
+    """Project onto merged M03 source, keeping its two UI callbacks verbatim."""
+    if path.endswith('/CommonsAttribution.kt'):
+        return before_m02_producer(path, text.encode()).decode()
+    if path.endswith('/MediaGalleryActivity.kt'):
+        text = replace_once(path, text, COMBINED_HELPER, '')
+        row = next(row for row in production_fixture()['entries'] if row['path'] == path)
+        edit = row['edits'][0]
+        text = replace_once(path, text, edit['before'], edit['after'])
+    return text
diff --git a/tools/commons_metadata_m03_font_scope.py b/tools/commons_metadata_m03_font_scope.py
new file mode 100644
index 0000000000..06243d1bb4
--- /dev/null
+++ b/tools/commons_metadata_m03_font_scope.py
@@ -0,0 +1,31 @@
+"""Reverse only the pinned additive M03 glyph delta, preserving old font oracles."""
+import base64
+import hashlib
+import json
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+FONT_SCOPE_PIN = 'fd3aae2b126d17aaffb5d6a9cdc0f6d87cccc9b044fdf61a2fe5c876a935d956'
+
+
+def font_fixture():
+    data = (ROOT / 'tools/fixtures/commons_metadata_m03_font_scope.json').read_bytes()
+    if hashlib.sha256(data).hexdigest() != FONT_SCOPE_PIN:
+        raise AssertionError('The pinned M03 one-glyph font delta changed')
+    return json.loads(data)
+
+
+def before_m03_font(data):
+    scope = font_fixture()
+    if len(data) != scope['after_bytes'] or hashlib.sha256(data).hexdigest() != scope['after_sha256']:
+        raise AssertionError('Expected exactly the approved M03 font, without unrelated changes')
+    for edit in reversed(scope['edits']):
+        at = edit['after_offset']
+        after = base64.b64decode(edit['after_base64'], validate=True)
+        before = base64.b64decode(edit['before_base64'], validate=True)
+        if data[at:at+len(after)] != after:
+            raise AssertionError('M03 font reverse delta does not match at its exact offset')
+        data = data[:at] + before + data[at+len(after):]
+    if len(data) != scope['before_bytes'] or hashlib.sha256(data).hexdigest() != scope['before_sha256']:
+        raise AssertionError('M03 font reversal did not restore the complete pinned historical font')
+    return data
diff --git a/tools/commons_metadata_m03_scope.py b/tools/commons_metadata_m03_scope.py
new file mode 100644
index 0000000000..f08dbca0c5
--- /dev/null
+++ b/tools/commons_metadata_m03_scope.py
@@ -0,0 +1,44 @@
+"""Exact M03 successor reversal; retain every historical source/catalogue hash."""
+import hashlib
+import json
+import pathlib
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+CATALOGUE_PIN = '2bf39ff3c05322e4ecb10adbe90e8790b6d53580073cd412b128324db47852ef'
+PRODUCTION_PIN = '27255affc9138de58320c994d215534e272f939e4e0e1935170fe857dc8a5220'
+
+
+def pinned(name, digest):
+    raw = (ROOT / 'tools/fixtures' / name).read_bytes()
+    if hashlib.sha256(raw).hexdigest() != digest:
+        raise AssertionError(f'The pinned M03 scope changed: {name}')
+    return json.loads(raw)
+
+
+def catalogue_fixture():
+    return pinned('commons_metadata_response_limit_scope.json', CATALOGUE_PIN)
+
+
+def production_fixture():
+    return pinned('commons_metadata_m03_production_scope.json', PRODUCTION_PIN)
+
+
+def before_m03_catalogue(path, text):
+    rows = {row['path']: row for row in catalogue_fixture()['entries']}
+    if path not in rows:
+        return text
+    line = rows[path]['line']
+    if text.count(line) != 1:
+        raise AssertionError(f'{path}: expected exactly one approved M03 addition')
+    return text.replace(line, '', 1)
+
+
+def before_m03_production(path, text):
+    rows = {row['path']: row for row in production_fixture()['entries']}
+    if path not in rows:
+        return text
+    for edit in reversed(rows[path]['edits']):
+        if text.count(edit['after']) != 1:
+            raise AssertionError(f'{path}: expected the exact M03 producer/callback delta')
+        text = text.replace(edit['after'], edit['before'], 1)
+    return text
