diff --git a/.github/workflows/android-legacy.yml b/.github/workflows/android-legacy.yml
new file mode 100644
index 0000000000..9c20efc6ab
--- /dev/null
+++ b/.github/workflows/android-legacy.yml
@@ -0,0 +1,153 @@
+# Android 5.0 / 7.0 compatibility is deliberately opt-in.
+# Ordinary and full CI remain defined only in android.yml.
+name: Android legacy compatibility (manual)
+
+on:
+  workflow_dispatch:
+    inputs:
+      versions:
+        description: 'Android platform versions'
+        required: true
+        type: choice
+        default: both
+        options: [both, '21', '24']
+      abis:
+        description: 'Emulator architecture (x86 tests the 32-bit native path)'
+        required: true
+        type: choice
+        default: both
+        options: [both, x86, x86_64]
+
+permissions:
+  contents: read
+
+defaults:
+  run:
+    shell: bash
+
+env:
+  BUILD_VARIANT: debug
+
+jobs:
+  build:
+    name: Build once for selected legacy emulators
+    runs-on: ubuntu-22.04
+    # Match the reconciled cold universal-build allowance in android.yml.
+    timeout-minutes: 45
+    env:
+      CCACHE_MAXSIZE: 2G
+      CCACHE_COMPILERCHECK: content
+      CCACHE_SLOPPINESS: ''
+      CCACHE_NODEPEND: '1'
+      CCACHE_NODIRECT: '1'
+      CMAKE_C_COMPILER_LAUNCHER: ccache
+      CMAKE_CXX_COMPILER_LAUNCHER: ccache
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+      - uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
+        with:
+          path: |
+            ~/.gradle/caches/modules-2
+            ~/.gradle/wrapper/dists
+            Paintroid/build/jxl-source
+            Paintroid/build/webp-source
+            Paintroid/build/heif-source
+            Paintroid/build/tiff-source
+          key: android-deps-v1-${{ runner.os }}-${{ hashFiles('**/*.gradle', 'gradle/wrapper/gradle-wrapper.properties', 'tools/fetch_*_sources.py') }}-legacy
+          restore-keys: android-deps-v1-${{ runner.os }}-${{ hashFiles('**/*.gradle', 'gradle/wrapper/gradle-wrapper.properties', 'tools/fetch_*_sources.py') }}-
+      - name: Set native compiler cache directory
+        run: echo "CCACHE_DIR=$RUNNER_TEMP/anpaint-ccache" >> "$GITHUB_ENV"
+      - name: Restore content-checked native compiler cache
+        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
+        with:
+          path: ${{ env.CCACHE_DIR }}
+          key: native-ccache-v1-ubuntu22-4.5.1-${{ hashFiles('Paintroid/build.gradle', 'tools/ci_prepare_build.sh') }}-${{ hashFiles('Paintroid/src/main/cpp/**', 'tools/fetch_*_sources.py') }}
+          restore-keys: |
+            native-ccache-v1-ubuntu22-4.5.1-${{ hashFiles('Paintroid/build.gradle', 'tools/ci_prepare_build.sh') }}-
+            native-ccache-v1-ubuntu22-4.5.1-
+      - name: Install pinned compiler cache
+        timeout-minutes: 2
+        run: |
+          timeout --kill-after=5s 90s sudo apt-get install -y --no-install-recommends ccache=4.5.1-1
+          ccache --zero-stats
+      - name: Prepare build tools and notices
+        timeout-minutes: 8
+        run: bash tools/ci_prepare_build.sh
+      - name: Verify emulator script syntax
+        run: bash -n tools/ci_emulator.sh
+      - name: Build universal APK
+        timeout-minutes: 30
+        run: |
+          ./gradlew --no-daemon --max-workers=2 --console=plain \
+            :app:assembleDebug -PciReleaseSigning
+      - name: Compile both instrumentation APKs
+        timeout-minutes: 3
+        run: |
+          ./gradlew --no-daemon --max-workers=2 --console=plain \
+            :Paintroid:assembleDebugAndroidTest :app:assembleDebugAndroidTest -PciReleaseSigning
+      - name: Validate exact APKs supplied to emulators
+        run: |
+          set -euo pipefail
+          for apk in \
+              app/build/outputs/apk/debug/app-debug.apk \
+              Paintroid/build/outputs/apk/androidTest/debug/Paintroid-debug-androidTest.apk \
+              app/build/outputs/apk/androidTest/debug/app-debug-androidTest.apk; do
+            test -s "$apk"
+            sha256sum "$apk"
+          done
+      - name: Native compiler cache statistics
+        if: always()
+        run: if command -v ccache >/dev/null; then ccache --show-stats; fi
+      - name: Upload exact APKs for compatibility checks
+        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
+        with:
+          archive: true
+          name: legacy-test-apks-${{ github.run_id }}
+          retention-days: 14
+          if-no-files-found: error
+          path: |
+            app/build/outputs/apk/debug/app-debug.apk
+            Paintroid/build/outputs/apk/androidTest/debug/Paintroid-debug-androidTest.apk
+            app/build/outputs/apk/androidTest/debug/app-debug-androidTest.apk
+
+  device:
+    name: Android API ${{ matrix.api }} / ${{ matrix.abi }}
+    needs: build
+    runs-on: ubuntu-22.04
+    timeout-minutes: 30
+    strategy:
+      fail-fast: false
+      matrix:
+        api: ${{ fromJSON(inputs.versions == 'both' && '[21,24]' || inputs.versions == '21' && '[21]' || '[24]') }}
+        abi: ${{ fromJSON(inputs.abis == 'both' && '["x86","x86_64"]' || inputs.abis == 'x86' && '["x86"]' || '["x86_64"]') }}
+    env:
+      TEST_API: ${{ matrix.api }}
+      EMULATOR_ABI: ${{ matrix.abi }}
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+      - uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
+        with:
+          name: legacy-test-apks-${{ github.run_id }}
+          path: build/prebuilt
+      - name: Install legacy emulator image
+        timeout-minutes: 8
+        run: |
+          sudo chmod a+rw /dev/kvm
+          timeout --kill-after=15s 7m "$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager" \
+            "system-images;android-$TEST_API;google_apis;$EMULATOR_ABI" "emulator"
+      - name: Run prebuilt legacy instrumentation
+        timeout-minutes: 17
+        run: bash tools/ci_emulator.sh
+      - name: Upload per-platform diagnostics even on failure
+        if: always()
+        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
+        with:
+          archive: true
+          name: legacy-api-${{ matrix.api }}-${{ matrix.abi }}-${{ github.run_id }}
+          retention-days: 14
+          if-no-files-found: warn
+          path: build/reports/android-api-${{ matrix.api }}/
diff --git a/CI.md b/CI.md
index 118845f653..c650cfba09 100644
--- a/CI.md
+++ b/CI.md
@@ -951,3 +951,51 @@ image provisioning and four for other job overhead. The API30 modeled path stays
 wait arithmetic, not a universal liveness proof. No KVM, permission, signing or
 repository-visibility setting is changed. Fresh exact-head timings, full union,
 original screenshots and source/APK provenance remain required for acceptance.
+
+## Android 5.0 and 7.0 compatibility — manually triggered only
+
+The separate [Android legacy compatibility workflow](.github/workflows/android-legacy.yml)
+has **only** `workflow_dispatch`. It does not run on pushes, pull requests,
+routine `current` runs or `full` runs. It does not change the regular API 35
+or full API 30/35 matrix, and its result is not an implicit release gate.
+
+From **Actions → Android legacy compatibility (manual) → Run workflow**, choose
+`versions` = `both` (default), `21` (Android 5.0) or `24` (Android 7.0);
+choose `abis` = `both` (default), `x86` (32-bit) or `x86_64`.
+The default dispatch runs four independent emulator jobs. Alternatively,
+from an authenticated local GitHub CLI:
+
+```sh
+gh workflow run android-legacy.yml --ref develop -f versions=both -f abis=both
+```
+
+The build job produces **one identical universal debug APK** plus both test APKs.
+Its cold-build allowances match the regular workflow: a 45-minute build job,
+30 minutes for universal assembly, and a separate three-minute test-APK compile
+step. No instrumentation/device deadline is extended by this build allowance.
+Each selected emulator downloads those exact binaries, installs the target app
+and SDK-eligible test APK, and invokes the existing strict test-inventory/protocol
+runner. The SDK-ineligible app-test APK is retained as a build artifact. A failed install, boot, test, test-inventory
+check or timeout is a failed device job, not a reported success. Each device
+job uploads startup, emulator, logcat and instrumentation reports even if it
+fails. Android 5.0 uses `pm path` for its older package-manager shell, and
+does not attempt the unsupported `wm dismiss-keyguard` command; all first-boot
+emulators use an unprotected lock screen. The native/import suite still runs.
+Current ordinary editor classes require API 26 or later, gallery-draft requires
+API 30, and vertical-locale requires API 29.
+On API 21/24 these app phases are explicitly **NOT RUN**, not passes. The strict
+app source-inventory verifier proves that no selected SDK-eligible app methods
+remain; if a new eligible ordinary method is added, this omission policy fails
+closed until the legacy app execution plan is updated. Its zero-test receipt has
+`success: null`, `execution_status: not-run-no-sdk-eligible-selected-tests`, and
+separate SDK-suppressed and explicitly excluded identities. No empty fake
+instrumentation summary is created. Ultra HDR (API 34+) is SDK-suppressed, and
+the separate API35-only gallery force-stop phases are explicitly excluded as in
+existing lower-API runs.
+
+Passing these emulator checks establishes only the recorded emulator/API/ABI
+coverage. It does not prove compatibility with physical ARMv7/ARM64 Android 5/7
+devices, manufacturer document pickers, all native codec variants, or constrained
+RAM. Failures should be corrected and verified in a fresh **manual** dispatch,
+rather than quietly weakening tests or automatically adding legacy device jobs
+to release or push/PR CI.
