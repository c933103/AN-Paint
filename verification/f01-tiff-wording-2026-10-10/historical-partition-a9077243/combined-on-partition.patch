++class TiffC023WordingTests(unittest.TestCase):
++    def test_exact_single_definition_and_unchanged_checkbox(self):
++        root = ET.parse(ROOT / PATH).getroot()
++        nodes = root.findall(f"./string[@name='{KEY}']")
++        self.assertEqual(1, len(nodes))
