+        while (!ready() && System.nanoTime() < until) {
+            shadowOf(Looper.getMainLooper()).idleFor(16, TimeUnit.MILLISECONDS)
+            if (!ready()) Thread.sleep(1)
+        }
+        assertTrue(label, ready())
